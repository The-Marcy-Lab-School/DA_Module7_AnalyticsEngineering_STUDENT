# This is an EXAMPLE only -- see ../GETTING_STARTED.md for the full
# walkthrough. Your real profiles.yml goes in ~/.dbt/profiles.yml, on
# your machine, OUTSIDE this repo -- it holds real database credentials
# and must never be committed. This example file is safe to keep in the
# repo (no real values), just here so you can see the exact shape dbt
# expects.
#
# The top-level key must match dbt_project.yml's own `profile:` value
# exactly -- "analytics_engineering_project" is already set there for
# you, don't rename one without the other.

analytics_engineering_project:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost          # or your hosted Module 3 DB's real host
      port: 5432                # or your hosted DB's real port
      user: your_db_user
      password: your_db_password
      dbname: your_module3_db_name
      schema: dbt_dev           # dbt will create/use this schema for its own output tables -- doesn't need to exist yet
      threads: 4
